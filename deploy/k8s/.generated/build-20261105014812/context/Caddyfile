{
  admin off
  skip_install_trust
  default_sni 127.0.0.1
  auto_https disable_redirects
  servers {
    protocols h1 h2
    timeouts {
      read_body 10s
      read_header 5s
      write 45s
      idle 30s
    }
    max_header_size 16KB
  }
}
https://localhost:8443, https://127.0.0.1:8443 {
  tls internal
  reverse_proxy api:8080 {
    transport http {
      dial_timeout 3s
      response_header_timeout 40s
    }
  }
}
https://localhost:9443, https://127.0.0.1:9443 {
  tls internal
  reverse_proxy operator:8080 {
    transport http {
      dial_timeout 3s
      response_header_timeout 40s
    }
  }
}
