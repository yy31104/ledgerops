[1.957491, "o", "Checker report: {\"anomalies\": {\"G-single\": [{\"cycle\": [{\"from\": 0, \"kinds\": [\"ww\"], \"to\": 1}, {\"from\": 1, \"kinds\": [\"rw\"], \"to\": 0}]}], \"lost-update\": [{\"key\": \"30000000-0000-4000-8000-000000000002\", \"read_version\": 1, \"txns\": [0, 1]}, {\"key\": \"30000000-0000-4000-8000-000000000003\", \"read_version\": 0, \"txns\": [0, 1]}], \"non-adjacent-rmw\": [{\"key\": \"30000000-0000-4000-8000-000000000002\", \"read\": 1, \"txn\": 1, \"wrote\": 3}, {\"key\": \"30000000-0000-4000-8000-000000000003\", \"read\": 0, \"txn\": 1, \"wrote\": 2}]}, \"stats\": {\"committed\": 2, \"edges\": {\"rw\": 1, \"wr\": 0, \"ww\": 1}, \"failed\": 0, \"graph_nodes\": 2, \"indeterminate\": 0, \"transactions\": 2}, \"valid\": false}\r\nCorrect totals hid a stale read. The history checker rejected the execution.\r\n"]
